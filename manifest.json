{
  "schemaVersion": 1,
  "id": "antouank.protonvpn",
  "name": "ProtonVPN",
  "version": "1.2.0",
  "author": "antouank",
  "license": "MIT",
  "description": "ProtonVPN status, connect/disconnect, and sign-in/sign-out in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "ProtonVPN",
    "description": "Toggle ProtonVPN on/off and sign in or out of your account.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
